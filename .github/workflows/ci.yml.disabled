name: CI - Test and Lint

on:
  pull_request:
    branches: [main, develop]
  push:
    branches: [main, develop]

jobs:
  # Backend 테스트
  test-backend:
    name: Test Backend
    runs-on: ubuntu-latest
    
    steps:
      - name: 코드 체크아웃
        uses: actions/checkout@v4
      
      - name: Python 3.11 설정
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
      
      - name: Backend 의존성 설치
        run: |
          cd backend
          pip install -r requirements.txt
          pip install pytest pytest-cov flake8
      
      - name: Backend 코드 품질 검사 (Flake8)
        run: |
          cd backend
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
          flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics
        continue-on-error: true
      
      - name: Backend 테스트 실행
        run: |
          cd backend
          pytest tests/ -v --cov=. --cov-report=term-missing
        continue-on-error: true

  # Scentmap 테스트
  test-scentmap:
    name: Test Scentmap
    runs-on: ubuntu-latest
    
    steps:
      - name: 코드 체크아웃
        uses: actions/checkout@v4
      
      - name: Python 3.11 설정
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
      
      - name: Scentmap 의존성 설치
        run: |
          cd scentmap
          pip install -r requirements.txt
          pip install pytest flake8
      
      - name: Scentmap 코드 품질 검사
        run: |
          cd scentmap
          flake8 . --count --exit-zero --max-line-length=127 --statistics
        continue-on-error: true

  # Layering 테스트
  test-layering:
    name: Test Layering
    runs-on: ubuntu-latest
    
    steps:
      - name: 코드 체크아웃
        uses: actions/checkout@v4
      
      - name: Python 3.11 설정
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
      
      - name: Layering 의존성 설치
        run: |
          cd layering
          pip install -r requirements.txt
          pip install pytest flake8
      
      - name: Layering 테스트 실행
        run: |
          cd layering
          pytest tests/ -v
        continue-on-error: true

  # Frontend 테스트
  test-frontend:
    name: Test Frontend
    runs-on: ubuntu-latest
    
    steps:
      - name: 코드 체크아웃
        uses: actions/checkout@v4
      
      - name: Node.js 20 설정
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: frontend/package-lock.json
      
      - name: Frontend 의존성 설치
        run: |
          cd frontend
          npm ci
      
      - name: Frontend Lint 검사
        run: |
          cd frontend
          npm run lint
        continue-on-error: true
      
      - name: Frontend 빌드 테스트
        run: |
          cd frontend
          npm run build
        env:
          SKIP_ENV_VALIDATION: true

  # 전체 결과 요약
  ci-summary:
    name: CI Summary
    runs-on: ubuntu-latest
    needs: [test-backend, test-scentmap, test-layering, test-frontend]
    if: always()
    
    steps:
      - name: CI 결과 출력
        run: |
          echo "✅ CI 파이프라인 완료!"
          echo "Backend: ${{ needs.test-backend.result }}"
          echo "Scentmap: ${{ needs.test-scentmap.result }}"
          echo "Layering: ${{ needs.test-layering.result }}"
          echo "Frontend: ${{ needs.test-frontend.result }}"
